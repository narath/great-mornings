# DreamHost is Apache. Without this, a browser downloads recitations/*.md
# as a file instead of showing it — and /recitations/individual.md is meant
# to be a readable URL, not an attachment.
AddType text/plain .md

AddDefaultCharset UTF-8

# LICENSE and NOTICE have no extension, so Apache sends them with no type
# and a browser offers to download them. They are meant to be read.
<FilesMatch "^(LICENSE|NOTICE)$">
  ForceType text/plain
</FilesMatch>

# Browsers ask for /favicon.ico whatever the page declares — the PDF, for
# one, is not our HTML. Point it at the icon we do ship.
RedirectMatch 301 ^/favicon\.ico$ /assets/icon.png

<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/css "access plus 7 days"
  ExpiresByType font/woff2 "access plus 1 year"
  ExpiresByType image/png "access plus 30 days"
  ExpiresByType text/html "access plus 1 hour"
</IfModule>
